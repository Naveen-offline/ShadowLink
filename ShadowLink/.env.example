# Copy to .env and edit. Never commit .env.
SECRET_KEY=change-me-to-a-long-random-string
FLASK_ENV=development
DATABASE_URL=sqlite:///shadowlink.db
SESSION_COOKIE_SECURE=false        # set true when served over HTTPS
# Optional analysis modules
DNS_ANALYSIS_ENABLED=true
RDAP_ENABLED=true
TLS_INSPECTION_ENABLED=true        # TLS handshake only, to validated public IPs
# Live HTTP fetching for redirect analysis. DISABLED BY DEFAULT.
LIVE_FETCH_ENABLED=false
MAX_REDIRECTS=5
CONNECT_TIMEOUT=4
READ_TIMEOUT=4
MAX_RESPONSE_BYTES=65536
# Retention
SCAN_RETENTION_DAYS=90
# First admin (created by `flask create-admin`, password is prompted)
